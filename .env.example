# ============================================================
# 闲鱼低价商品监控系统 - 环境变量样例
# 用法：cp .env.example .env，然后按需填写
# 注意：.env 及所有真实凭据禁止提交到 Git（已由 .gitignore 排除）
# ============================================================

# 运行环境：development | test | staging | production（默认 development）
NODE_ENV=development

# ---------- 必填 ----------
# PostgreSQL 连接串（占位示例，请替换）
DATABASE_URL=postgresql://user:change-me@localhost:5432/xianyu_dev
# Redis 连接串
REDIS_URL=redis://localhost:6379

# ---------- 可选 ----------
# API 监听端口（默认 3000）
PORT=3000
# 日志级别：debug | info | warn | error（默认 info）
LOG_LEVEL=info

# RabbitMQ（MVP 可先用 Redis/BullMQ，不配置则不用队列）
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# 邮件通知（EXT-002 凭据到位后启用）
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=notify@example.com
# EMAIL_SMTP_PASSWORD=change-me
# EMAIL_FROM=notify@example.com

# 企业微信机器人
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=change-me

# 数据源授权（EXT-001 授权到位后启用）
# DATASOURCE_AUTH_TOKEN=change-me
# 授权会话 storageState 受控目录（必须位于 .gitignore 覆盖范围）
# DATASOURCE_STORAGE_STATE_DIR=runtime/storage-state
