// 闲鱼低价商品监控系统 - 数据库 Schema（DB-001）
// 约定：金额一律整数分；时间一律 TIMESTAMPTZ（带时区）；主键 UUID。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// 用户状态：正常 / 禁用 / 待验证
enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_VERIFICATION
}

/// 套餐标识：免费 / 专业 / 企业
enum PlanCode {
  FREE
  PRO
  ENTERPRISE
}

/// 监控任务状态：启用 / 暂停 / 异常
enum MonitorStatus {
  ACTIVE
  PAUSED
  ERROR
}

/// 用户（5.1 users 表）
/// 密码只保存强哈希（passwordHash）；软删除用 deletedAt，查询层默认过滤。
model User {
  id                     String             @id @default(uuid()) @db.Uuid
  email                  String             @unique
  passwordHash           String             @map("password_hash")
  displayName            String?            @map("display_name")
  status                 UserStatus         @default(ACTIVE)
  planCode               PlanCode           @default(FREE) @map("plan_code")
  timezone               String             @default("Asia/Shanghai")
  notificationPreferences Json?             @map("notification_preferences")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?          @map("deleted_at") @db.Timestamptz(6)

  @@index([planCode, status], map: "idx_users_plan_status")
  @@map("users")

  monitors KeywordMonitor[]
  notifications NotificationRecord[]
}

/// 关键词监控任务（5.2 keyword_monitors 表）
/// 金额一律整数分（targetPriceCent）；阈值用 DECIMAL(5,4)（如 0.7000）；
/// 频率/阈值/样本量的范围校验在 Repository 层执行（配合数据库枚举约束）。
model KeywordMonitor {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword           String
  normalizedKeyword String         @map("normalized_keyword")
  categoryCode      String?        @map("category_code")
  targetPriceCent   BigInt         @map("target_price_cent")
  discountThreshold Decimal        @map("discount_threshold") @db.Decimal(5, 4)
  minSampleSize     Int            @default(10) @map("min_sample_size")
  frequencyMinutes  Int            @map("frequency_minutes")
  filters           Json?
  notifyChannels    Json?          @map("notify_channels")
  status            MonitorStatus  @default(ACTIVE)
  lastCollectedAt   DateTime?      @map("last_collected_at") @db.Timestamptz(6)
  nextRunAt         DateTime?      @map("next_run_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status], map: "idx_monitors_user_status")
  @@index([status, nextRunAt], map: "idx_monitors_status_next_run")
  @@index([normalizedKeyword], map: "idx_monitors_normalized_keyword")
  @@map("keyword_monitors")

  runs MonitorRun[]
  notifications NotificationRecord[]
}

/// 通知投递状态：待发送 / 已发送 / 失败（可重试）/ 死信 / 抑制
enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD
  SUPPRESSED
}

/// 任务运行状态
enum MonitorRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// 通知记录（5.5 notification_records 表）
/// idempotency_key 唯一：同一商品/规则/用户窗口不重复通知；
/// retry_count 记录失败重试次数；delivery_status 驱动重试与死信。
model NotificationRecord {
  id               String                      @id @default(uuid()) @db.Uuid
  userId           String                      @map("user_id") @db.Uuid
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorId        String                      @map("monitor_id") @db.Uuid
  monitor          KeywordMonitor              @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  productId        String                      @map("product_id") @db.Uuid
  product          Product                     @relation(fields: [productId], references: [id])
  channel          String
  eventType        String                      @map("event_type")
  ruleVersion      String                      @map("rule_version")
  productPriceCent BigInt                      @map("product_price_cent")
  marketPriceCent  BigInt?                     @map("market_price_cent")
  discountRate     Decimal?                    @map("discount_rate") @db.Decimal(6, 4)
  reason           Json?
  idempotencyKey   String                      @unique @map("idempotency_key")
  deliveryStatus   NotificationDeliveryStatus  @default(PENDING) @map("delivery_status")
  providerMessageId String?                    @map("provider_message_id")
  retryCount       Int                         @default(0) @map("retry_count")
  sentAt           DateTime?                   @map("sent_at") @db.Timestamptz(6)
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "idx_notif_user_created")
  @@index([monitorId, createdAt(sort: Desc)], map: "idx_notif_monitor_created")
  @@index([deliveryStatus], map: "idx_notif_delivery_status")
  @@map("notification_records")
}

/// 任务运行记录（推荐补充表 monitor_runs）
model MonitorRun {
  id           BigInt            @id @default(autoincrement())
  monitorId    String            @map("monitor_id") @db.Uuid
  monitor      KeywordMonitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status       MonitorRunStatus
  startedAt    DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?         @map("finished_at") @db.Timestamptz(6)
  resultCount  Int               @default(0) @map("result_count")
  errorMessage String?           @map("error_message")
  durationMs   Int?              @map("duration_ms")

  @@index([monitorId, startedAt(sort: Desc)], map: "idx_run_monitor_started")
  @@map("monitor_runs")
}

/// 管理/审计日志（推荐补充表 audit_logs）
/// 仅支持追加与只读查询，不提供修改/删除（普通用户 API 不可触达）。
model AuditLog {
  id           BigInt  @id @default(autoincrement())
  actorId      String? @map("actor_id") @db.Uuid
  action       String
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id")
  detail       Json?
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resourceType, resourceId], map: "idx_audit_resource")
  @@index([actorId, createdAt(sort: Desc)], map: "idx_audit_actor_created")
  @@map("audit_logs")
}

/// 商品主记录（5.3 products 表）
/// canonical_key（source + source_product_id）唯一，保证重复采集不建第二条主记录；
/// raw_payload 为数据源原始载荷，默认查询不返回（访问边界）。
/// 金额一律整数分（currentPriceCent）。
model Product {
  id               String                @id @default(uuid()) @db.Uuid
  source           String
  sourceProductId  String                @map("source_product_id")
  canonicalKey     String                @unique @map("canonical_key")
  title            String
  normalizedTitle  String                @map("normalized_title")
  url              String
  sellerIdHash     String?               @map("seller_id_hash")
  currentPriceCent BigInt                @map("current_price_cent")
  currency         String                @default("CNY")
  condition        String?
  location         String?
  publishedAt      DateTime?             @map("published_at") @db.Timestamptz(6)
  firstSeenAt      DateTime              @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt       DateTime              @map("last_seen_at") @db.Timestamptz(6)
  rawPayload       Json?                 @map("raw_payload")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  priceHistory ProductPriceHistory[]
  notifications NotificationRecord[]

  @@index([source, sourceProductId], map: "idx_products_source_prod")
  @@map("products")
}

/// 商品价格历史（5.4 product_price_history 表）
/// source_event_id 唯一 → 同一事件重复消费不产生重复历史行（幂等）。
/// 按月分区预留：Phase 2（DB-005）按 observed_at Range 分区，此处先建索引。
model ProductPriceHistory {
  id              BigInt    @id @default(autoincrement())
  productId       String    @map("product_id") @db.Uuid
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceCent       BigInt    @map("price_cent")
  shippingFeeCent BigInt?   @map("shipping_fee_cent")
  observedAt      DateTime  @map("observed_at") @db.Timestamptz(6)
  sourceEventId   String?   @unique @map("source_event_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, observedAt(sort: Desc)], map: "idx_ph_product_observed")
  @@index([observedAt], map: "idx_ph_observed_at")
  @@map("product_price_history")
}
